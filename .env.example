# Node server settings. Copy to .env in the project root.
PORT=3000
HOST=127.0.0.1
# On a hosting service set HOST=0.0.0.0 and use the service-provided PORT.
# Comma-separated browser origins, without paths or trailing slashes.
ALLOWED_ORIGINS=https://gim1203-hue.github.io
# Optional: absolute directory on a persistent disk. Defaults to ./data.
# DATA_DIR=/var/data/market-lane
